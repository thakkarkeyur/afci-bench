+
+const VALID_STATUSES: OrderStatus[] = ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'];
+
+export function validateUpdateOrderInput(input: UpdateOrderRequest): ValidationResult {
+  const errors: string[] = [];
+
+  if (input.items === undefined && input.status === undefined) {
+    errors.push('At least one field (items or status) must be provided');
+  }
+
+  if (input.items !== undefined) {
+    const itemsValidation = validateOrderItems(input.items);
+    errors.push(...itemsValidation.errors);
+  }
+
+  if (input.status !== undefined && !VALID_STATUSES.includes(input.status)) {
+    errors.push(`Invalid status: ${input.status}`);
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
