+
+export interface UpdateOrderPorts {
+  orderRepository: OrderRepository;
+  logger: Logger;
+  correlationId: string;
+}
+
+export interface UpdateOrderResult {
+  success: boolean;
+  data?: OrderResponse;
+  errors?: string[];
+  notFound?: boolean;
+}
+
+export async function updateOrderUseCase(
+  orderId: string,
+  input: UpdateOrderRequest,
+  ports: UpdateOrderPorts
+): Promise<UpdateOrderResult> {
+  const startTime = Date.now();
+  const { orderRepository, logger, correlationId } = ports;
+
+  try {
+    const validation = validateUpdateOrderInput(input);
+    if (!validation.valid) {
+      logger.logRequest({
+        correlationId,
+        operation: 'updateOrder',
+        status: 'fail',
+        latencyMs: Date.now() - startTime,
+      });
+      return { success: false, errors: validation.errors };
+    }
+
+    const existing = await orderRepository.findById(orderId);
+    if (!existing) {
+      logger.logRequest({
+        correlationId,
+        operation: 'updateOrder',
+        status: 'fail',
+        latencyMs: Date.now() - startTime,
+      });
+      return { success: false, notFound: true, errors: ['Order not found'] };
+    }
+
+    const updated = applyOrderUpdates(existing, input);
+    const saved = await orderRepository.update(updated);
+
+    if (!saved) {
+      logger.logRequest({
+        correlationId,
+        operation: 'updateOrder',
+        status: 'fail',
+        latencyMs: Date.now() - startTime,
+      });
+      return { success: false, notFound: true, errors: ['Order not found'] };
+    }
+
+    const responseItems: OrderItemResponse[] = saved.items.map((item) => ({
+      productId: item.productId,
+      name: item.name,
+      quantity: item.quantity,
+      unitPrice: item.unitPrice,
+      subtotal: item.subtotal,
+    }));
+
+    const response: OrderResponse = {
+      id: saved.id,
+      customerId: saved.customerId,
+      items: responseItems,
+      total: saved.total,
+      status: saved.status,
+      createdAt: saved.createdAt.toISOString(),
+    };
+
+    logger.logRequest({
+      correlationId,
+      operation: 'updateOrder',
+      status: 'success',
+      latencyMs: Date.now() - startTime,
+    });
+
+    return { success: true, data: response };
+  } catch (error) {
+    const errorMessage = error instanceof Error ? error.message : 'Unknown error';
+
+    logger.logError({
+      correlationId,
+      errorType: 'UpdateOrderError',
+      message: errorMessage,
+      stack: error instanceof Error ? error.stack : undefined,
+    });
+
+    logger.logRequest({
+      correlationId,
+      operation: 'updateOrder',
+      status: 'fail',
+      latencyMs: Date.now() - startTime,
+    });
+
+    return { success: false, errors: [errorMessage] };
+  }
+}
