+const VALID_STATUSES: OrderStatus[] = ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'];
+
+export function validateUpdateOrderInput(input: UpdateOrderRequest): ValidationResult {
+  const errors: string[] = [];
+
+  if (input.status === undefined && input.items === undefined) {
+    errors.push('At least one field (status or items) must be provided');
+  }
+
+  if (input.status !== undefined && !VALID_STATUSES.includes(input.status)) {
+    errors.push(`Invalid status: ${input.status}`);
+  }
+
+  if (input.items !== undefined) {
+    const itemsValidation = validateOrderItems(input.items);
+    errors.push(...itemsValidation.errors);
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+export function applyOrderUpdates(order: Order, input: UpdateOrderRequest): Order {
+  const updated = { ...order };
+
+  if (input.status !== undefined) {
+    updated.status = input.status;
+  }
+
+  if (input.items !== undefined) {
+    const newItems = input.items.map(createOrderItem);
+    updated.items = newItems;
+    updated.total = calculateOrderTotal(newItems);
+  }
+
+  return updated;
