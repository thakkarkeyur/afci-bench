+
+// List orders use case
+
+const DEFAULT_LIMIT = 20;
+const MAX_LIMIT = 100;
+
+export interface ListOrdersPorts {
+  orderRepository: OrderRepository;
+  logger: Logger;
+  correlationId: string;
+}
+
+export interface ListOrdersResult {
+  success: boolean;
+  data?: ListOrdersResponse;
+  errors?: string[];
+}
+
+export async function listOrdersUseCase(
+  limit: number | undefined,
+  offset: number | undefined,
+  ports: ListOrdersPorts
+): Promise<ListOrdersResult> {
+  const startTime = Date.now();
+  const { orderRepository, logger, correlationId } = ports;
+
+  const resolvedLimit = Math.min(limit ?? DEFAULT_LIMIT, MAX_LIMIT);
+  const resolvedOffset = offset ?? 0;
+
+  try {
+    const { orders, total } = await orderRepository.findAll(resolvedLimit, resolvedOffset);
+
+    const data: ListOrdersResponse = {
+      data: orders.map((order) => ({
+        id: order.id,
+        customerId: order.customerId,
+        items: order.items.map((item): OrderItemResponse => ({
+          productId: item.productId,
+          name: item.name,
+          quantity: item.quantity,
+          unitPrice: item.unitPrice,
+          subtotal: item.subtotal,
+        })),
+        total: order.total,
+        status: order.status,
+        createdAt: order.createdAt.toISOString(),
+      })),
+      total,
+      limit: resolvedLimit,
+      offset: resolvedOffset,
+    };
+
+    logger.logRequest({
+      correlationId,
+      operation: 'listOrders',
+      status: 'success',
+      latencyMs: Date.now() - startTime,
+    });
+
+    return { success: true, data };
+  } catch (error) {
+    const errorMessage = error instanceof Error ? error.message : 'Unknown error';
+
+    logger.logError({
+      correlationId,
+      errorType: 'ListOrdersError',
+      message: errorMessage,
+      stack: error instanceof Error ? error.stack : undefined,
+    });
+
+    logger.logRequest({
+      correlationId,
+      operation: 'listOrders',
+      status: 'fail',
+      latencyMs: Date.now() - startTime,
+    });
+
+    return { success: false, errors: [errorMessage] };
+  }
+}
