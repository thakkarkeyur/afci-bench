+
+export async function cancelOrderUseCase(
+  orderId: string,
+  ports: CancelOrderPorts
+): Promise<OrderResult> {
+  const startTime = Date.now();
+  const { orderRepository, logger, correlationId } = ports;
+
+  try {
+    const existing = await orderRepository.findById(orderId);
+    if (!existing) {
+      logger.logRequest({
+        correlationId,
+        operation: 'cancelOrder',
+        status: 'fail',
+        latencyMs: Date.now() - startTime,
+      });
+      return { success: false, errors: ['Order not found'] };
+    }
+
+    if (existing.status === OrderStatus.CANCELLED) {
+      logger.logRequest({
+        correlationId,
+        operation: 'cancelOrder',
+        status: 'fail',
+        latencyMs: Date.now() - startTime,
+      });
+      return { success: false, errors: ['Order is already cancelled'] };
+    }
+
+    const cancelledOrder: Order = {
+      ...existing,
+      status: OrderStatus.CANCELLED,
+    };
+
+    const saved = await orderRepository.save(cancelledOrder);
+
+    logger.logRequest({
+      correlationId,
+      operation: 'cancelOrder',
+      status: 'success',
+      latencyMs: Date.now() - startTime,
+    });
+
+    return { success: true, data: orderToResponse(saved) };
+  } catch (error) {
+    const errorMessage = error instanceof Error ? error.message : 'Unknown error';
+    logger.logError({
+      correlationId,
+      errorType: 'CancelOrderError',
+      message: errorMessage,
+      stack: error instanceof Error ? error.stack : undefined,
+    });
+    logger.logRequest({
+      correlationId,
+      operation: 'cancelOrder',
+      status: 'fail',
+      latencyMs: Date.now() - startTime,
+    });
+    return { success: false, errors: [errorMessage] };
+  }
+}
