+
+export interface CancelOrderPorts {
+  orderRepository: OrderRepository;
+  logger: Logger;
+  correlationId: string;
+}
+
+export interface CancelOrderResult {
+  success: boolean;
+  data?: OrderResponse;
+  errorType?: 'not_found' | 'already_cancelled' | 'internal';
+  errors?: string[];
+}
+
+export async function cancelOrderUseCase(
+  orderId: string,
+  _input: CancelOrderRequest,
+  ports: CancelOrderPorts
+): Promise<CancelOrderResult> {
+  const startTime = Date.now();
+  const { orderRepository, logger, correlationId } = ports;
+
+  try {
+    const existing = await orderRepository.findById(orderId);
+
+    if (!existing) {
+      logger.logRequest({
+        correlationId,
+        operation: 'cancelOrder',
+        status: 'fail',
+        latencyMs: Date.now() - startTime,
+      });
+
+      return {
+        success: false,
+        errorType: 'not_found',
+        errors: [`Order not found: ${orderId}`],
+      };
+    }
+
+    const cancelled = cancelOrder(existing);
+    const saved = await orderRepository.save(cancelled);
+
+    const responseItems: OrderItemResponse[] = saved.items.map((item) => ({
+      productId: item.productId,
+      name: item.name,
+      quantity: item.quantity,
+      unitPrice: item.unitPrice,
+      subtotal: item.subtotal,
+    }));
+
+    const response: OrderResponse = {
+      id: saved.id,
+      customerId: saved.customerId,
+      items: responseItems,
+      total: saved.total,
+      status: saved.status,
+      createdAt: saved.createdAt.toISOString(),
+    };
+
+    logger.logRequest({
+      correlationId,
+      operation: 'cancelOrder',
+      status: 'success',
+      latencyMs: Date.now() - startTime,
+    });
+
+    return {
+      success: true,
+      data: response,
+    };
+  } catch (error) {
+    if (error instanceof OrderAlreadyCancelledError) {
+      logger.logRequest({
+        correlationId,
+        operation: 'cancelOrder',
+        status: 'fail',
+        latencyMs: Date.now() - startTime,
+      });
+
+      return {
+        success: false,
+        errorType: 'already_cancelled',
+        errors: [error.message],
+      };
+    }
+
+    const errorMessage = error instanceof Error ? error.message : 'Unknown error';
+
+    logger.logError({
+      correlationId,
+      errorType: 'CancelOrderError',
+      message: errorMessage,
+      stack: error instanceof Error ? error.stack : undefined,
+    });
+
+    logger.logRequest({
+      correlationId,
+      operation: 'cancelOrder',
+      status: 'fail',
+      latencyMs: Date.now() - startTime,
+    });
+
+    return {
+      success: false,
+      errorType: 'internal',
+      errors: [errorMessage],
+    };
+  }
+}
