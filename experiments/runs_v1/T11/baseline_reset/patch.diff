+
+export function validateOrderCancellation(order: Order): ValidationResult {
+  const errors: string[] = [];
+
+  const cancellableStatuses: OrderStatus[] = ['pending', 'confirmed'];
+  if (!cancellableStatuses.includes(order.status)) {
+    errors.push(`Cannot cancel order with status '${order.status}'`);
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
