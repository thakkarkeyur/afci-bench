{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afci-bench/experiments/v2/harness/run_record.schema.json",
  "title": "AFCI-Bench v2 Runner Run Record",
  "description": "Self-describing record of ONE runner execution, dry-run included. It is deliberately NOT experiments/v2/schemas/run_manifest.schema.json: that schema sets additionalProperties:false, carries none of SL-PT08-01 section 9's six quarantine fields, and lives in a directory byte-pinned by the private evaluator's public linkage, so adding the fields there is a linkage-relevant change this package is not authorised to make. A run record is not a result: producing one freezes nothing, passes no gate, and enters no dataset. The run_purpose block is mandatory and an unmarked record is invalid, never confirmatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "run_id",
    "run_purpose",
    "task_id",
    "task_sha256",
    "condition",
    "mode",
    "state_log",
    "model",
    "environment",
    "protocol_versions",
    "worktree",
    "context_audit",
    "fresh_launch",
    "invocation",
    "model_identity",
    "post_run_capture",
    "evaluation",
    "manifest_freeze",
    "artifacts",
    "prerequisite_blockers",
    "outcome"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "record_kind": { "type": "string", "enum": ["runner_run_record"] },
    "run_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "run_purpose": {
      "type": "object",
      "additionalProperties": false,
      "description": "SL-PT08-01 section 9, and SL-V2-QUAL-01 section 3.1 for the qualification purpose. The five eligibility flags are derived from the purpose and never accepted from a caller; a record whose flags disagree with the purpose is refused rather than written. The name enum is a CLOSED list of the governed non-confirmatory run purposes: a record naming an unregistered purpose is invalid, and adding a purpose to it is a Study-Lead decision rather than a schema edit.",
      "required": [
        "name",
        "decision_id",
        "confirmatory",
        "confirmatory_eligible",
        "enters_confirmatory_dataset",
        "enters_confirmatory_e1_analysis",
        "enters_treatment_effect_analysis",
        "enters_power_estimation"
      ],
      "properties": {
        "name": { "type": "string", "enum": ["PT08_DIFFICULTY_DIAGNOSTIC", "INSTRUMENT_QUALIFICATION_DIAGNOSTIC", "AFCI_EFFICIENCY_PILOT"] },
        "decision_id": { "type": "string" },
        "confirmatory": { "type": "boolean", "enum": [false] },
        "confirmatory_eligible": { "type": "boolean", "enum": [false] },
        "enters_confirmatory_dataset": { "type": "boolean", "enum": [false] },
        "enters_confirmatory_e1_analysis": { "type": "boolean", "enum": [false] },
        "enters_treatment_effect_analysis": { "type": "boolean", "enum": [false] },
        "enters_power_estimation": { "type": "boolean", "enum": [false] }
      }
    },
    "task_id": { "type": "string" },
    "task_sha256": { "type": "string" },
    "condition": { "type": "string", "enum": ["C1", "C2", "C3", "C4"] },
    "mode": { "type": "string", "enum": ["dry-run", "real"] },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "SL-RUNID-01. The 1-based repetition index this run carries, and the value that separates R1/R2/R3 of one (purpose, task, condition, task hash, substrate hash, mode) in run_id. OPTIONAL in the schema ON PURPOSE: records written before SL-RUNID-01 carry no index and must stay readable and validatable rather than being rewritten. Every record the runner writes from SL-RUNID-01 onwards carries it."
    },
    "repetition_declared": {
      "type": "boolean",
      "description": "SL-RUNID-01. true when the caller declared the repetition index explicitly; false when the governed default of 1 was supplied. Recorded so a single run's record says which it was, instead of leaving a reader to guess whether an index of 1 was chosen or defaulted."
    },
    "state_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "result"],
        "properties": {
          "state": { "type": "string" },
          "result": { "type": "string", "enum": ["ENTERED", "PASS", "SKIPPED", "REFUSED"] },
          "code": { "type": ["string", "null"] },
          "detail": { "type": "string" }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_model_id", "resolved_model_id", "effort_input", "selection_status"],
      "properties": {
        "requested_model_id": { "type": ["string", "null"] },
        "resolved_model_id": { "type": ["string", "null"] },
        "effort_input": { "type": ["string", "null"] },
        "selection_status": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "governed_cli_version", "observed_cli_version", "governed_agent_sdk_version", "python_version"],
      "properties": {
        "os": { "type": "string" },
        "governed_cli_version": { "type": ["string", "null"] },
        "observed_cli_version": { "type": ["string", "null"] },
        "governed_agent_sdk_version": { "type": ["string", "null"] },
        "python_version": { "type": "string" },
        "isolated_environment_verified": { "type": "boolean" }
      }
    },
    "protocol_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_spec",
        "oracle_spec",
        "acceptance_spec",
        "reset_protocol",
        "model_execution_config",
        "guard_spec",
        "worktree_policy",
        "diagnostic_decision"
      ],
      "properties": {
        "condition_spec": { "type": "string" },
        "oracle_spec": { "type": "string" },
        "acceptance_spec": { "type": "string" },
        "reset_protocol": { "type": "string" },
        "model_execution_config": { "type": "string" },
        "guard_spec": { "type": "string" },
        "worktree_policy": { "type": "string" },
        "diagnostic_decision": { "type": "string" }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement", "prepared_root", "prepared_manifest_path", "content_hash"],
      "properties": {
        "enforcement": { "type": "object" },
        "prepared_root": { "type": "string" },
        "prepared_manifest_path": { "type": "string" },
        "content_hash": { "type": "string" }
      }
    },
    "context_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "report_path", "report_sha256", "reason_count"],
      "properties": {
        "verdict": { "type": "string", "enum": ["CLEAN", "CONTAMINATED", "UNKNOWN", "ERROR"] },
        "report_path": { "type": ["string", "null"] },
        "report_sha256": { "type": ["string", "null"] },
        "reason_count": { "type": "integer" },
        "reasons_sample": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fresh_launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "executable", "session_handling", "manifest_path"],
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" } },
        "env_keys": { "type": "array", "items": { "type": "string" } },
        "executable": { "type": "boolean" },
        "requested_model_id": { "type": ["string", "null"] },
        "model_status": { "type": "string" },
        "effort_input": { "type": ["string", "null"] },
        "session_handling": { "type": "string" },
        "manifest_path": { "type": ["string", "null"] },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The PERMISSION allowlist, distinct from the tool set. Empty for every purpose that freezes none, which is what every run before SL-V2-EFF-01 did. OPTIONAL so records written before this field existed still validate."
        },
        "tools": { "type": "array", "items": { "type": "string" } },
        "max_turns": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "SL-V2-EFF-RESET-01's agentic-turn ceiling for this process, or null when the authorising purpose freezes none. Never defaulted to a number."
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoked", "status", "exit_status", "runtime_evidence_path"],
      "properties": {
        "invoked": { "type": "boolean" },
        "status": { "type": "string" },
        "exit_status": { "type": ["integer", "null"] },
        "runtime_evidence_path": { "type": ["string", "null"] },
        "detail": { "type": "string" },
        "started_at": { "type": ["string", "null"] },
        "ended_at": { "type": ["string", "null"] },
        "wall_clock_seconds": { "type": ["number", "null"] },
        "stderr_path": { "type": ["string", "null"] },
        "event_count": { "type": ["integer", "null"] },
        "termination_method": {
          "type": ["string", "null"],
          "description": "How the process was made to stop. NOT_TERMINATED is the honest answer for one that ended on its own; a hard tree kill is recorded as TERMINATED_PROCESS_TREE and never relabelled as a graceful stop."
        },
        "completion": { "type": ["string", "null"] },
        "stopped_early": { "type": ["boolean", "null"] },
        "stop_event_index": { "type": ["integer", "null"] },
        "max_turns_reached": {
          "type": ["boolean", "null"],
          "description": "True when the terminal result event carried subtype error_max_turns. That run exits 1 by design and is NOT a process failure."
        }
      }
    },
    "reset": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "SL-V2-EFF-RESET-01. Present only for a run whose purpose declares a reset state. OPTIONAL in the schema ON PURPOSE: every record written before this field existed carries no reset state and must stay valid and unrewritten. A reset_state of NON_RESET is a positive statement that the run was one process, not an absence.",
      "required": ["reset_state"],
      "properties": {
        "reset_state": { "type": "string", "enum": ["NON_RESET", "RESET"] },
        "status": { "type": ["string", "null"] },
        "single_process": { "type": ["boolean", "null"] },
        "max_turns": { "type": ["integer", "null"] },
        "budget_authority": { "type": ["string", "null"] },
        "checkpoint_authority": { "type": ["string", "null"] },
        "checkpoint_id": { "type": ["string", "null"] },
        "checkpoint_hash": { "type": ["string", "null"] },
        "checkpoint_reached": { "type": ["boolean", "null"] },
        "checkpoint_event_index": { "type": ["integer", "null"] },
        "checkpoint_evidence": { "type": ["object", "null"] },
        "phase_a_session_id": { "type": ["string", "null"] },
        "phase_b_session_id": { "type": ["string", "null"] },
        "phase_a_model": { "type": ["string", "null"] },
        "phase_b_model": { "type": ["string", "null"] },
        "phase_a_runtime": { "type": ["string", "null"] },
        "phase_b_runtime": { "type": ["string", "null"] },
        "phase_a_context_audit": { "type": ["string", "null"] },
        "phase_b_context_audit": { "type": ["string", "null"] },
        "phase_a_termination_method": { "type": ["string", "null"] },
        "pre_reset_turn_limit": { "type": ["integer", "null"] },
        "post_reset_turn_limit": { "type": ["integer", "null"] },
        "pre_reset_turns_used": { "type": ["integer", "null"] },
        "post_reset_turns_used": { "type": ["integer", "null"] },
        "reset_handoff_seconds": { "type": ["number", "null"] },
        "fresh_phase_b_process": { "type": ["boolean", "null"] },
        "fresh_phase_b_profile": { "type": ["boolean", "null"] },
        "fresh_phase_b_session": { "type": ["boolean", "null"] },
        "same_worktree_across_reset": { "type": ["boolean", "null"] },
        "phase_a_summarised_into_phase_b": { "type": "boolean", "enum": [false] },
        "resume_used": { "type": "boolean", "enum": [false] },
        "continue_used": { "type": "boolean", "enum": [false] },
        "conversation_reused": { "type": "boolean", "enum": [false] },
        "unused_pre_reset_transfers": { "type": "boolean", "enum": [false] },
        "total_allowance": { "type": ["integer", "null"] },
        "detail": { "type": ["string", "null"] },
        "phases": { "type": ["object", "null"] }
      }
    },
    "efficiency": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "SL-V2-EFF-01's measurement block. OPTIONAL: records written before it existed carry none and stay valid. TOTAL_OUTPUT_TOKENS is nullable because a reset run's phase A is interrupted before its terminal result event, and the streamed per-message output figure is the message-start value rather than the total — so the output figure is withheld rather than understated. All three INPUT categories reconstruct exactly from the partial stream and are never withheld."
    },
    "functional_evaluation": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "SL-V2-EFF-FUNC-01. The post-run functional-validity block. Present only for a run whose purpose a Study-Lead decision put the channel on. OPTIONAL in the schema ON PURPOSE: every record written before this field existed carries none and must stay valid and unrewritten, which is why the PT08, PT09 and PT10 records already on disk are untouched by it. functional_valid is DERIVED from the semantic counts by experiments/v2/harness/functional_evaluation.py and re-derived again when the record is assembled; it is never a value a caller supplies. The NON-SEMANTIC counts are recorded and reported and enter no clause of that derivation. An evaluation that could not be performed is written with executed=false and a runtime_error, never omitted: 'this run was not functionally valid' and 'nobody looked' are different facts.",
      "required": [
        "record",
        "authority",
        "executed",
        "evaluator_task",
        "semantic_case_count_expected",
        "semantic_case_count_executed",
        "semantic_pass_count",
        "semantic_fail_count",
        "semantic_error_count",
        "nonsemantic_case_count_expected",
        "nonsemantic_case_count_executed",
        "nonsemantic_pass_count",
        "nonsemantic_fail_count",
        "nonsemantic_error_count",
        "missing_case_ids",
        "duplicate_case_ids",
        "runtime_error",
        "functional_valid"
      ],
      "properties": {
        "record": {
          "type": "string",
          "const": "afci-bench/v2/functional-evaluation"
        },
        "authority": {
          "type": "string",
          "const": "SL-V2-EFF-FUNC-01"
        },
        "authority_record": {
          "type": ["string", "null"]
        },
        "executed": {
          "type": "boolean"
        },
        "evaluator_task": {
          "type": "string"
        },
        "evaluator_version": {
          "type": ["string", "null"]
        },
        "evaluator_runtime_sha256": {
          "type": ["string", "null"]
        },
        "evaluator_suite_sha256": {
          "type": ["string", "null"]
        },
        "semantic_case_count_expected": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_case_count_executed": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_pass_count": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "nonsemantic_case_count_expected": {
          "type": "integer",
          "minimum": 0
        },
        "nonsemantic_case_count_executed": {
          "type": "integer",
          "minimum": 0
        },
        "nonsemantic_pass_count": {
          "type": "integer",
          "minimum": 0
        },
        "nonsemantic_fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "nonsemantic_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_semantic_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "indeterminate_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicate_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unexpected_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_error": {
          "type": ["object", "null"],
          "required": ["code", "detail"],
          "properties": {
            "code": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "functional_valid": {
          "type": "boolean"
        },
        "functional_valid_is_derived": {
          "type": "boolean",
          "const": true
        },
        "functional_valid_derived_by": {
          "type": ["string", "null"]
        },
        "nonsemantic_cases_do_not_determine_validity": {
          "type": "boolean",
          "const": true
        },
        "architecture_scored": {
          "type": "boolean",
          "const": false
        },
        "worktree_unchanged_during_evaluation": {
          "type": ["boolean", "null"]
        },
        "assertions_per_case": {
          "type": ["object", "null"]
        },
        "transport": {
          "type": ["object", "null"]
        },
        "scorer": {
          "type": ["object", "null"]
        }
      }
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requested_model_id", "resolved_model_id"],
      "properties": {
        "status": { "type": "string" },
        "requested_model_id": { "type": ["string", "null"] },
        "resolved_model_id": { "type": ["string", "null"] },
        "evidence_sources": { "type": "array", "items": { "type": "string" } },
        "detail": { "type": "string" }
      }
    },
    "post_run_capture": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "evaluation": { "type": "object" },
    "manifest_freeze": { "type": "object" },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "prerequisite_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "detail", "is_result", "scored"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["DRY_RUN_COMPLETE", "DRY_RUN_REFUSED", "COMPLETE", "REFUSED"]
        },
        "code": { "type": ["string", "null"] },
        "detail": { "type": "string" },
        "is_result": { "type": "boolean", "enum": [false] },
        "scored": { "type": "boolean", "enum": [false] }
      }
    }
  }
}
