{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afci-bench/experiments/v2/schemas/guard_result.schema.json",
  "title": "AFCI-Bench v2 Architecture-Guard Result",
  "description": "Output of the v2 architecture guard for one run, plus the guard's own validation metadata. Development scaffolding for study v2; no paid run produced it. The v1 guard matched literal libs/* paths and was blind to the repo's @afci-bench/* aliases (total=0 on a real violation); a v2 guard MUST be alias-aware and validated (precision/recall + mutation tests, gate G6) before any conformance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "condition",
    "guard_version",
    "alias_aware",
    "matched_path_patterns",
    "findings",
    "finding_count",
    "validation",
    "verdict"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "condition": { "type": "string", "enum": ["C1", "C2", "C3", "C4"] },
    "guard_version": { "type": "string" },
    "alias_aware": { "type": "boolean" },
    "matched_path_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "path", "import_path", "severity", "kind", "evidence_ref"],
        "properties": {
          "rule_id": { "type": "string" },
          "path": { "type": "string" },
          "import_path": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "kind": { "type": "string" },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "finding_count": { "type": "integer" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "recall", "corpus_ref", "mutation_tests_passed"],
      "properties": {
        "precision": { "type": ["number", "null"] },
        "recall": { "type": ["number", "null"] },
        "corpus_ref": { "type": ["string", "null"] },
        "mutation_tests_passed": { "type": ["boolean", "null"] }
      }
    },
    "verdict": { "type": "string", "enum": ["CLEAN", "VIOLATIONS", "PENDING"] }
  }
}
