# Line-ending and binary-file hygiene.
#
# Pinning LF in the working tree keeps checkouts byte-identical across
# platforms, overriding any local core.autocrlf setting. Existing blobs are
# already LF, so this introduces no content change.
* text=auto eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
