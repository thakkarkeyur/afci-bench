{
  "root": true,
  "ignorePatterns": ["**/*"],
  "plugins": ["@nx"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": [],
            "depConstraints": [
              {
                "sourceTag": "scope:contracts",
                "onlyDependOnLibsWithTags": []
              },
              {
                "sourceTag": "scope:observability",
                "onlyDependOnLibsWithTags": []
              },
              {
                "sourceTag": "scope:core",
                "onlyDependOnLibsWithTags": ["scope:contracts"]
              },
              {
                "sourceTag": "scope:features",
                "onlyDependOnLibsWithTags": ["scope:core", "scope:contracts", "scope:observability"]
              },
              {
                "sourceTag": "scope:infra",
                "onlyDependOnLibsWithTags": ["scope:contracts", "scope:observability"]
              },
              {
                "sourceTag": "scope:api",
                "onlyDependOnLibsWithTags": ["scope:features", "scope:infra", "scope:contracts", "scope:observability"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "extends": ["plugin:@nx/typescript"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "error",
        "@typescript-eslint/explicit-function-return-type": "warn",
        "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
      }
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nx/javascript"],
      "rules": {}
    }
  ]
}
